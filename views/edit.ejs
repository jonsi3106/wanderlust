<% layout("/boilerplate.ejs")%>

    <body>
        <div class="container">
            <form method="post" action="/listings/<%= place._id %>?_method=PUT">
            <div class="row ">
                <div class="col col-8 offset-2-2">
                    <h2 class="edit">Edit Your Listing</h2>


                    <div class="edit">
                        <label for="title" class="title">Title</label>
                        <br>
                        <input class="form-control w-100" name="listing[title]" type="text" value="<%=place.title%>">
                    </div>

                    <div class="edit">
                        <label for="description" class="description">Description</label>
                        <br>
                        <textarea class="form-control w-100" name="listing[description]" id="description"><%=place.description%></textarea>
                    </div>

                    <div class="edit">
                        <label for="image" class="image">Image Link</label>
                        <br>
                        <input class="form-control w-100" name="listing[image][url]" type="text" value="<%=place.image.url%>">
                    </div>

                    <div class="edit">
                        <label for="price" class="price">Price</label>
                        <br>
                        <input class="form-control w-100" name="listing[price]" type="number" value="<%=place.price%>">
                    </div>


                    <div class="edit">
                        <label for="location" class="location">Location</label>
                        <br>
                        <input class="form-control w-100" name="listing[location]" type="text" value="<%=place.location%>">
                    </div>

                    <div class="edit">
                        <label for="country" class="country">Country</label>
                        <br>
                        <input class="form-control w-100" name="listing[country]" type="text" value="<%=place.country%>">
                    </div>


                    <button class="edit-btn">update</button>
                </div>
            </div>
        </form>
        </div>
    </body>