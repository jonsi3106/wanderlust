<% layout("/boilerplate.ejs")%>

    <body>
       
       <div class="row">

 <% for(const listing of allListings){%>
    <div class="card overley" style="width: 22rem;">
                <a class="card-anchor" href="/listings/<%= listing.id%>">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="img">
                <div class="card-body">
                    <p class="card-text">
                       <b><%= listing.title%></b> 
                            <br>
                            &#x20B9; <%= listing.price.toLocaleString("en-IN")%>/night
                    </p>
                </div>
            </a>
        </div>
            <% } %>

       </div>



               


    </body>