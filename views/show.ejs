<% layout("/boilerplate.ejs")%>

    <body>

        <div class="row">

            <div class="col col-6 offset-3-2">
                <h2>
                    Listing Details:
                </h2>

                <div class="card">
                    <img src=" <%= place.image.url %>" class="card-img-top" alt="image">
                    <div class="card-body">

                        <ul class="card-text">
                            <li>
                                <b>
                                    <%= place.title %>
                                </b>
                            </li>
                            <li>
                                <%= place.description %>
                            </li>
                            <li>
                                &#x20B9; <%= place.price.toLocaleString("en-IN") %>/night
                            </li>
                            <li>
                                <%= place.location %>
                            </li>
                            <li>
                                <%= place.country %>
                            </li>

                        </ul>

                    </div>
                </div>

                <div class="show-btn">

                    <form method="get" action="/listings/<%=place.id%>/edit">
                        <button class="edit-btn">edit</button>
                    </form>

                    <br><br>

                    <form method="post" action="/listings/<%=place.id%>?_method=delete">
                        <button class="delete-btn">Delete</button>
                    </form>

                </div>

            </div>

            <hr>

            <div class="col col-6 offset-3-2">
                <form action="/listings/<%=place.id%>/reviews" method="post">
                    <div>
                        <label for="rating">rating</label>
                        <input type="range" min="1" max="5" id="rating" name="review[ratings]">
                    </div>
                    <div>
                        <label for="comment"> add comments</label>
                        <textarea name="review[comments]" id="comment"></textarea>
                    </div>
                    <button>post</button>
                </form>
            </div>

            <div>

                <hr>

                <h3>Reviews:</h3>

                <div class="row">
                    <% for(const review of place.reviews){ %>
                        <div class="col-sm-6">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <%= review.username %>
                                    </h5>
                                    (<%= review.ratings %>/5):
                                        <p class="card-text">
                                            <%= review.comments %>
                                        </p>
                                        
                                        <form
                                            action="/listings/<%= place._id %>/reviews/<%= review._id %>?_method=DELETE"
                                            method="POST">
                                            <button class="btn btn-danger">Delete</button>
                                        </form>
                                </div>
                            </div>
                        </div>
                        <% }%>

                </div>
            </div>


        </div>




    </body>